# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional
# PORT=3000
# PLANAWAY_MODEL=claude-opus-5-5
# PLANAWAY_EFFORT=medium   # low | medium | high | xhigh | max
# PLANAWAY_DATA_DIR=data/trips

# Optional: the route map and place photos use free services (OpenStreetMap,
# OpenFreeMap, Wikimedia) and need no keys. Overrides, e.g. to self-host:
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_EMAIL=you@example.com   # identifies your app to the public Nominatim server
# PHOTON_URL=https://photon.komoot.io   # starting point suggestions in Settings
# ROUTING_URL=https://routing.openstreetmap.de   # routes between stops (OSRM)

# Before going live (see "Going live" in README.md):
# APP_URL=https://planaway.example.com   # the site's public address, for links in emails (required in production)
# OPERATOR_NAME=Your Name                # who runs PlanAway, named on the Privacy and Terms pages and in emails
# CONTACT_EMAIL=support@example.com      # where Contact page messages go; shown on the Contact, Privacy, and Terms pages

# Cost guard: agent requests each account can make in 24 hours (0 = no limit).
# PLANAWAY_DAILY_TURNS=20

# Confirming new accounts' email addresses with a 6-digit code before they can
# sign in. Off by default, since it needs SMTP below; set to "on" once email works.
# EMAIL_VERIFICATION=on

# Email (confirming addresses, password resets, the contact form), over SMTP.
# Without SMTP_HOST, emails are printed to the server log instead.
# A Gmail account works without buying a domain (about 500 emails a day): turn on
# 2-Step Verification, make an app password, and use it as SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465               # TLS from the start; 587 upgrades with STARTTLS
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=              # the 16-letter app password, without spaces
# EMAIL_FROM=PlanAway <you@gmail.com>   # Gmail sends only from the account's own address
# Other providers (Resend, Postmark, SES, Mailgun) work the same way, with their host and login.
