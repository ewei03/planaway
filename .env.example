# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional
# PORT=3000
# PLANAWAY_MODEL=claude-opus-5-5
# PLANAWAY_EFFORT=medium   # low | medium | high | xhigh | max

# Required: signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: a Postgres connection string. Without it, PlanAway uses an
# embedded Postgres (PGlite) stored in data/pglite.
# DATABASE_URL=postgres://planaway:planaway@localhost:5432/planaway
